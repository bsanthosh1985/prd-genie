        "jsCode": "const r = $input.first().json;\n\nlet src = r.source_file;\nif (!src) { try { src = $('Loop Over Items').item.json.source_file; } catch (e) {} }\n\nconst base = String(src || 'file').replace(/\\.[^.]+$/, '').replace(/[^\\w\\- ]+/g, '_').trim() || 'file';\nconst suffix = String(r.trace_id || Date.now()).replace(/-/g, '').slice(0, 6);\nconst file_name = `PRD_${base}_${suffix}.md`;\n\nconst body = r.markdown || '# No output\\n\\nThe run returned no result for this file.';\nconst header = `<!-- Source file: ${src || 'unknown'} | Route: ${r.status || 'n/a'} -->\\n\\n`;\n\nreturn [{ json: { file_name, content: header + body, status: r.status } }];"
      },

      "parameters": {
        "jsCode": "const out = [];\n$input.all().forEach((it, i) => {\n  let name = '';\n  const tryName = (fn) => {\n    if (name) return;\n    try { const v = fn(); if (v) name = String(v); } catch (e) {}\n  };\n\n  tryName(() => $('Download file').itemMatching(i).binary.data.fileName);\n  tryName(() => $('List Inbox Files').itemMatching(i).json.name);\n  tryName(() => $('Google Drive Trigger').itemMatching(i).json.name);\n  tryName(() => it.binary && it.binary.data && it.binary.data.fileName);\n  if (!name) name = `file_${i + 1}`;\n\n  const text = String(it.json.text ?? it.json.data ?? '').trim();\n  const lower = name.toLowerCase();\n  const input_type = lower.includes('brief') ? 'brief'\n    : lower.includes('note') ? 'notes'\n    : 'transcript';\n\n  out.push({ json: { input_text: text, input_type, source_file: name } });\n});\nreturn out;"
      },
